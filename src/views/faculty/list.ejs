<%- include('../partials/header') %>

<main>
  <h1>Faculty Directory</h1>

  <% if (typeof greeting !== 'undefined' && greeting) { %>
    <div class="greeting"><%- greeting %></div>
  <% } %>

  <p>Browse faculty members and click a name to view their full profile.</p>

  <section class="sections">
    <div class="sections-header">
      <h2>Faculty</h2>
      <div class="sort-options">
        <span>Sort by:</span>
        <a href="/faculty?sort=name" class="<%= currentSort === 'name' ? 'active' : '' %>">Name</a>
        <a href="/faculty?sort=department" class="<%= currentSort === 'department' ? 'active' : '' %>">Department</a>
        <a href="/faculty?sort=title" class="<%= currentSort === 'title' ? 'active' : '' %>">Title</a>
      </div>
    </div>

    <div class="section-list">
      <% if (!faculty || faculty.length === 0) { %>
        <p>No faculty found.</p>
      <% } else { %>
        <% faculty.forEach(person => { %>
          <div class="section-card">
            <div class="section-time">
              <a href="/faculty/<%= person.id %>?sort=<%= currentSort %>"><%= person.name %></a>
            </div>
            <div class="section-room">Department: <%= person.department %></div>
            <div class="section-professor">Title: <%= person.title %></div>
            <div class="section-room">Office: <%= person.office %></div>
            <div class="section-professor">Email: <%= person.email %></div>
          </div>
        <% }) %>
      <% } %>
    </div>
  </section>
</main>

<%- include('../partials/footer') %>